{
  "repository": "ha-homelab/ha-desloc-card",
  "mode": "release",
  "default_branch": "main",
  "visibility": "public",
  "version_file": "package.json",
  "validation_workflows": [
    "ci.yml",
    "codeql.yml",
    "dependency-review.yml",
    "hacs.yml"
  ],
  "artifact_pattern": "release-assets*",
  "local_checks": [
    "npm ci --ignore-scripts",
    "npm test",
    "python3 scripts/test_package_card.py"
  ],
  "notes": [
    "HACS consumes the unchanged ha-desloc-card.js asset name; SHA256SUMS and version metadata bind the packaged entry point.",
    "Releases contain the frontend card only. Synthetic DOM fuzzing does not establish physical lock state or Home Assistant device acceptance.",
    "The configured release-note file remains a full-validation input so its current release section, upgrade notes and security notes are checked.",
    "HACS information-file and image checks remain active for documentation-only pull requests."
  ],
  "release_notes": "CHANGELOG.md",
  "single_entry_ci": true,
  "fuzzing": {
    "toolkit_ref": "77b0157695fb80e4d97c3ac4819c2d1db7ba96c7"
  },
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "files": [
      {
        "path": "package.json",
        "format": "json",
        "field": "version",
        "value": "package"
      },
      {
        "path": "package-lock.json",
        "format": "npm-lock",
        "package": "ha-desloc-card",
        "value": "package"
      }
    ],
    "artifacts": [
      {
        "path": "ha-desloc-card.version.json",
        "format": "json",
        "field": "version",
        "value": "package"
      }
    ],
    "toolkit_revision": "5e413f80a4353d328b4529eae57992ac3987e2dd",
    "required_build_receipts": [
      "release-inputs-card.json"
    ]
  },
  "toolkit_revision": "5e413f80a4353d328b4529eae57992ac3987e2dd",
  "change_scope": {
    "documentation_paths": [
      "GOVERNANCE.md",
      "ROADMAP.md"
    ],
    "required_paths": [
      "CHANGELOG.md"
    ],
    "always_validate_workflows": [
      "codeql.yml",
      "hacs.yml"
    ]
  }
}
